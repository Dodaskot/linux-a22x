// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
/*
 * Samsung Galaxy A22 5G (SM-A226B, "a22x") - minimal mainline bring-up.
 *
 * The stock LK looks up a lot of nodes in the kernel DTB, applies dtbo.img on
 * top of it and panics when something is missing (bootargs, mediatek,scp, ...).
 * The base is therefore the stock DTB with everything mainline does not use
 * disabled (see mt6833-samsung-a22x-lk-compat.dtsi); real hardware support
 * is enabled here node by node.
 *
 * No reserved-memory nodes are added here: LK inserts its own mblock
 * reservations (framebuffer, pstore, ...) and hangs in
 * reserved_memory_conflict_check if the DTB already describes them
 * differently. ramoops is configured by LK through ramoops.* cmdline params.
 */

/dts-v1/;
#include <dt-bindings/clock/mt6833-clk.h>
#include <dt-bindings/power/mediatek,mt6833-power.h>
#include <dt-bindings/thermal/mediatek,lvts-thermal.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/mt6833-pinfunc.h>
#include <dt-bindings/pinctrl/mt65xx.h>
#include "mt6833-samsung-a22x-lk-compat.dtsi"

/ {
	model = "Samsung Galaxy A22 5G (SM-A226B)";
	compatible = "samsung,a22x", "mediatek,mt6833";

	aliases {
		serial0 = &apuart0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "serial0:921600n8";
		bootargs = "console=ttyS0,921600n8";

		framebuffer@7c9b0000 {
			compatible = "simple-framebuffer";
			reg = <0 0x7c9b0000 0 (1088 * 2408 * 4)>;
			width = <1080>;
			height = <2408>;
			stride = <(1088 * 4)>;
			format = "a8r8g8b8";
			backlight = <&backlight>;
			/*
			 * Physical size (stock panel driver: 68.43 x 152.57 mm), else
			 * simpledrm assumes 96 dpi and the OSK gets far too thin. Not a
			 * "panel" phandle: that variant hung at the boot logo (v73).
			 */
			width-mm = <68>;
			height-mm = <152>;
		};
	};

	pio_ml: pinctrl@10005000 {
		compatible = "mediatek,mt6833-pinctrl";
		reg = <0 0x10005000 0 0x1000>,
		      <0 0x11c30000 0 0x1000>,
		      <0 0x11d10000 0 0x1000>,
		      <0 0x11d40000 0 0x1000>,
		      <0 0x11e20000 0 0x1000>,
		      <0 0x11e60000 0 0x1000>,
		      <0 0x11ea0000 0 0x1000>,
		      <0 0x1000b000 0 0x1000>;
		reg-names = "gpio", "iocfg_rb", "iocfg_bm", "iocfg_br",
			    "iocfg_lm", "iocfg_bl", "iocfg_rt", "eint";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&pio_ml 0 0 201>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts = <0 212 4>;

		/* Mux only; pulls and drive strength stay as the bootloader set them. */
		uart0_pins: uart0-pins {
			pins-rx-tx {
				pinmux = <PINMUX_GPIO61__FUNC_URXD0>,
					 <PINMUX_GPIO62__FUNC_UTXD0>;
			};
		};

		spi1_pins: spi1-pins {
			pins-bus {
				pinmux = <PINMUX_GPIO27__FUNC_SPI1_CLK>,
					 <PINMUX_GPIO28__FUNC_SPI1_CSB>,
					 <PINMUX_GPIO29__FUNC_SPI1_MO>,
					 <PINMUX_GPIO30__FUNC_SPI1_MI>;
			};
		};

		touch_pins: touch-pins {
			pins-irq {
				pinmux = <PINMUX_GPIO14__FUNC_GPIO14>;
				input-enable;
			};
			pins-reset {
				pinmux = <PINMUX_GPIO15__FUNC_GPIO15>;
				output-high;
			};
		};

		/* AFE <-> MT6359 (MTKAIF) and speaker I2S, vendor states */
		/* MTKAIF clock/sync: switched on once at AFE init, always running */
		aud_clk_mosi_off_ml: aud-clk-mosi-off {
			pins-off {
				pinmux = <PINMUX_GPIO152__FUNC_GPIO152>,
					 <PINMUX_GPIO153__FUNC_GPIO153>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_clk_mosi_on_ml: aud-clk-mosi-on {
			pins-on {
				pinmux = <PINMUX_GPIO152__FUNC_AUD_CLK_MOSI>,
					 <PINMUX_GPIO153__FUNC_AUD_SYNC_MOSI>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		aud_dat_mosi_off_ml: aud-dat-mosi-off {
			pins-off {
				pinmux = <PINMUX_GPIO154__FUNC_GPIO154>,
					 <PINMUX_GPIO155__FUNC_GPIO155>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_dat_mosi_on_ml: aud-dat-mosi-on {
			pins-on {
				pinmux = <PINMUX_GPIO154__FUNC_AUD_DAT_MOSI0>,
					 <PINMUX_GPIO155__FUNC_AUD_DAT_MOSI1>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		aud_dat_miso_off_ml: aud-dat-miso-off {
			pins-off {
				pinmux = <PINMUX_GPIO159__FUNC_GPIO159>,
					 <PINMUX_GPIO160__FUNC_GPIO160>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_dat_miso_on_ml: aud-dat-miso-on {
			pins-on {
				pinmux = <PINMUX_GPIO159__FUNC_AUD_DAT_MISO0>,
					 <PINMUX_GPIO160__FUNC_AUD_DAT_MISO1>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		aud_gpio_i2s3_off_ml: aud-gpio-i2s3-off {
			pins-off {
				pinmux = <PINMUX_GPIO40__FUNC_GPIO40>,
					 <PINMUX_GPIO41__FUNC_GPIO41>,
					 <PINMUX_GPIO43__FUNC_GPIO43>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_gpio_i2s3_on_ml: aud-gpio-i2s3-on {
			pins-on {
				pinmux = <PINMUX_GPIO40__FUNC_I2S3_BCK>,
					 <PINMUX_GPIO41__FUNC_I2S3_LRCK>,
					 <PINMUX_GPIO43__FUNC_I2S3_DO>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		aud_gpio_i2s0_off_ml: aud-gpio-i2s0-off {
			pins-off {
				pinmux = <PINMUX_GPIO42__FUNC_GPIO42>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_gpio_i2s0_on_ml: aud-gpio-i2s0-on {
			pins-on {
				pinmux = <PINMUX_GPIO42__FUNC_I2S0_DI>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		spk_amp_pins: spk-amp-pins {
			pins-owi {
				pinmux = <PINMUX_GPIO169__FUNC_GPIO169>;
				bias-disable;
			};
		};

		/* vendor routes these to the SCP (SCP_SCL0/SDA0); AP I2C1 on the same pins */
		i2c1_pins: i2c1-pins {
			pins-bus {
				pinmux = <PINMUX_GPIO99__FUNC_SCL1>,
					 <PINMUX_GPIO100__FUNC_SDA1>;
			};
		};

		i2c5_pins: i2c5-pins {
			pins-bus {
				pinmux = <PINMUX_GPIO107__FUNC_SCL5>,
					 <PINMUX_GPIO108__FUNC_SDA5>;
			};
		};

		keypad_pins: keypad-pins {
			pins-cols {
				pinmux = <PINMUX_GPIO79__FUNC_KPCOL0>,
					 <PINMUX_GPIO80__FUNC_KPCOL1>;
			};
		};

		/* SD card slot (MSDC1); vendor drive strength 8 mA */
		/* IMU on SPI2 (the vendor drives it from the SCP via SCP_SPI2) */
		imu_int_pins: imu-int-pins {
			pins-int {
				pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
				input-enable;
				bias-disable;
			};
		};

		spi2_pins: spi2-pins {
			pins-spi {
				pinmux = <PINMUX_GPIO31__FUNC_SPI2_CLK>,
					 <PINMUX_GPIO32__FUNC_SPI2_CSB>,
					 <PINMUX_GPIO33__FUNC_SPI2_MO>;
				bias-disable;
			};

			pins-miso {
				pinmux = <PINMUX_GPIO34__FUNC_SPI2_MI>;
				input-enable;
				bias-pull-up;
			};
		};

		mmc1_pins: mmc1-pins {
			pins-cmd-dat {
				pinmux = <PINMUX_GPIO126__FUNC_MSDC1_CMD>,
					 <PINMUX_GPIO128__FUNC_MSDC1_DAT0>,
					 <PINMUX_GPIO127__FUNC_MSDC1_DAT1>,
					 <PINMUX_GPIO129__FUNC_MSDC1_DAT2>,
					 <PINMUX_GPIO130__FUNC_MSDC1_DAT3>;
				input-enable;
				drive-strength = <8>;
				bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			};

			pins-clk {
				pinmux = <PINMUX_GPIO125__FUNC_MSDC1_CLK>;
				drive-strength = <8>;
				bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			};

			pins-cd {
				pinmux = <PINMUX_GPIO4__FUNC_GPIO4>;
				input-enable;
				bias-pull-up;
			};
		};

		mmc0_pins: mmc0-pins {
			pins-bus {
				pinmux = <PINMUX_GPIO65__FUNC_MSDC0_DSL>,
					 <PINMUX_GPIO66__FUNC_MSDC0_CLK>,
					 <PINMUX_GPIO67__FUNC_MSDC0_CMD>,
					 <PINMUX_GPIO68__FUNC_MSDC0_RSTB>,
					 <PINMUX_GPIO69__FUNC_MSDC0_DAT0>,
					 <PINMUX_GPIO70__FUNC_MSDC0_DAT1>,
					 <PINMUX_GPIO71__FUNC_MSDC0_DAT2>,
					 <PINMUX_GPIO72__FUNC_MSDC0_DAT3>,
					 <PINMUX_GPIO73__FUNC_MSDC0_DAT4>,
					 <PINMUX_GPIO74__FUNC_MSDC0_DAT5>,
					 <PINMUX_GPIO75__FUNC_MSDC0_DAT6>,
					 <PINMUX_GPIO76__FUNC_MSDC0_DAT7>;
			};
		};
	};

	/* VEMC, left enabled by the bootloader for the boot eMMC. */
	reg_vemc: regulator-vemc {
		compatible = "regulator-fixed";
		regulator-name = "vemc";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	mmc0: mmc@11230000 {
		compatible = "mediatek,mt8183-mmc";
		reg = <0 0x11230000 0 0x10000>,
		      <0 0x11f50000 0 0x1000>;
		interrupts = <0 99 4>;
		clocks = <&topckgen CLK_TOP_MSDC50_0_SEL>,
			 <&infracfg_ao CLK_IFRAO_MSDC0>,
			 <&infracfg_ao CLK_IFRAO_MSDC0_SRC>;
		clock-names = "source", "hclk", "source_cg";
		bus-width = <8>;
		max-frequency = <200000000>;
		cap-mmc-highspeed;
		mmc-hs200-1_8v;
		vmmc-supply = <&reg_vemc>;
		pinctrl-names = "default", "state_uhs";
		pinctrl-0 = <&mmc0_pins>;
		pinctrl-1 = <&mmc0_pins>;
		non-removable;
		no-sd;
		no-sdio;
	};

	/* microSD slot: VMC (I/O, MT6360 LDO3) and VMCH (card, MT6360 LDO5) */
	mmc1: mmc@11240000 {
		compatible = "mediatek,mt8183-mmc";
		reg = <0 0x11240000 0 0x1000>,
		      <0 0x11c70000 0 0x1000>;
		interrupts = <0 103 4>;
		clocks = <&topckgen CLK_TOP_MSDC30_1_SEL>,
			 <&infracfg_ao CLK_IFRAO_MSDC1>,
			 <&infracfg_ao CLK_IFRAO_MSDC1_SRC>;
		clock-names = "source", "hclk", "source_cg";
		pinctrl-names = "default", "state_uhs";
		pinctrl-0 = <&mmc1_pins>;
		pinctrl-1 = <&mmc1_pins>;
		bus-width = <4>;
		max-frequency = <200000000>;
		cap-sd-highspeed;
		sd-uhs-sdr12;
		sd-uhs-sdr25;
		sd-uhs-sdr50;
		sd-uhs-sdr104;
		cd-gpios = <&pio_ml 4 GPIO_ACTIVE_HIGH>;
		vmmc-supply = <&mt6360_ldo5>;
		vqmmc-supply = <&mt6360_ldo3>;
		no-sdio;
		no-mmc;
	};

	u2phy: t-phy@11e40000 {
		compatible = "mediatek,mt6833-tphy", "mediatek,generic-tphy-v2";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0x11e40000 0x1000>;

		u2port0: usb-phy@0 {
			reg = <0x0 0x700>;
			clocks = <&uart_clk>;
			clock-names = "ref";
			#phy-cells = <1>;
		};
	};

	usb_otg: usb@11200000 {
		compatible = "mediatek,mt6833-musb", "mediatek,mtk-musb";
		reg = <0 0x11200000 0 0x1000>;
		interrupts = <0 96 4>;
		interrupt-names = "mc";
		phys = <&u2port0 PHY_TYPE_USB2>;
		dr_mode = "peripheral";
		clocks = <&infracfg_ao CLK_IFRAO_SSUSB>,
			 <&topckgen CLK_TOP_USB_TOP_SEL>,
			 <&topckgen CLK_TOP_UNIVPLL_D5_D4>;
		clock-names = "main", "mcu", "univpll";
	};

	/*
	 * LK leaves the TOPRGU watchdog running; let the kernel service it.
	 * The stock "mediatek,toprgu" node at the same address stays disabled.
	 */
	watchdog@10007000 {
		compatible = "mediatek,mt6833-wdt", "mediatek,mt6589-wdt";
		reg = <0 0x10007000 0 0x100>;
		#reset-cells = <1>;
	};
};

&apuart0 {
	clocks = <&uart_clk>, <&infracfg_ao CLK_IFRAO_UART0>;
	clock-names = "baud", "bus";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
};

/* The stock fixed clock lacks #clock-cells, so the UART driver cannot use it. */
&uart_clk {
	#clock-cells = <0>;
};

/*
 * Touch: Himax HX83112F TDDI on SPI1. LK's dtbo overlay enables &spi1 and
 * adds a "novatek@0" child (compatible list ending in "himax,common"); the
 * properties below are merged into that node.
 */
&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	clocks = <&topckgen CLK_TOP_MAINPLL_D5_D4>,
		 <&topckgen CLK_TOP_SPI_SEL>,
		 <&infracfg_ao CLK_IFRAO_SPI2>;
	clock-names = "parent-clk", "sel-clk", "spi-clk";
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_pins>;
	status = "okay";

	/* TDK ICM-40607 accelerometer/gyroscope (WHO_AM_I 0x38), INT1 on GPIO3 */
	imu@0 {
		compatible = "invensense,icm40607";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-cpha;
		spi-cpol;
		interrupts-extended = <&pio_ml 3 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "INT1";
		pinctrl-names = "default";
		pinctrl-0 = <&imu_int_pins>;
		/* chip X/Z point opposite the panel axes (checked with Plasma rotation) */
		mount-matrix = "-1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "-1";
	};
};

&spi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	clocks = <&topckgen CLK_TOP_MAINPLL_D5_D4>,
		 <&topckgen CLK_TOP_SPI_SEL>,
		 <&infracfg_ao CLK_IFRAO_SPI1>;
	clock-names = "parent-clk", "sel-clk", "spi-clk";
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	status = "okay";

	novatek@0 {
		compatible = "himax,hx83112f", "himax,common";
		reg = <0>;
		spi-max-frequency = <9600000>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_pins>;
		interrupts-extended = <&pio_ml 14 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio_ml 15 GPIO_ACTIVE_LOW>;
		irq-gpios = <&pio_ml 14 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2408>;
	};
};

/* MT6833 clock controllers (providers only for now; consumers still use stand-ins). */
&apmixed {
	status = "okay";
};

&topckgen {
	status = "okay";
};

&infracfg_ao {
	status = "okay";
};

&imp_iic_wrap_w {
	status = "okay";
};

&imp_iic_wrap_ws {
	status = "okay";
};

/ {
	/*
	 * I2C5 with the MT6360 sub-PMIC (charger, ADC, LDOs, Type-C). A separate
	 * node from the stock "i2c5": LK's dtbo overlay rewrites the children of
	 * the stock one with downstream compatibles. The stock node stays off.
	 */
	/* sensor bus: light/proximity and magnetometer, owned by the SCP on stock */
	i2c1_ml: i2c@11d20000 {
		compatible = "mediatek,mt6833-i2c", "mediatek,mt8192-i2c";
		reg = <0 0x11d20000 0 0x1000>,
		      <0 0x10217100 0 0x80>;
		interrupts = <0 113 4>;
		clocks = <&imp_iic_wrap_ws CLK_IMPWS_AP_CLOCK_RO_I2C1>,
			 <&infracfg_ao CLK_IFRAO_AP_DMA>;
		clock-names = "main", "dma";
		clock-div = <1>;
		clock-frequency = <400000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c1_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		light-sensor@46 {
			compatible = "a22x,mn78911";
			reg = <0x46>;
			/* palm over the sensor ~370, open ~60 */
			proximity-near-level = <200>;
		};

		magnetometer@30 {
			compatible = "memsic,mmc5603";
			reg = <0x30>;
		};
	};

	i2c5_ml: i2c@11e01000 {
		compatible = "mediatek,mt6833-i2c", "mediatek,mt8192-i2c";
		reg = <0 0x11e01000 0 0x1000>,
		      <0 0x10217500 0 0x80>;
		interrupts = <0 117 4>;
		clocks = <&imp_iic_wrap_w CLK_IMPW_AP_CLOCK_RO_I2C5>,
			 <&infracfg_ao CLK_IFRAO_AP_DMA>;
		clock-names = "main", "dma";
		clock-div = <1>;
		clock-frequency = <400000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c5_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		mt6360: pmic@34 {
			compatible = "mediatek,mt6360";
			reg = <0x34>;
			interrupts-extended = <&pio_ml 10 IRQ_TYPE_EDGE_FALLING>;
			interrupt-names = "IRQB";
			interrupt-controller;
			#interrupt-cells = <1>;

			mt6360_adc: adc {
				compatible = "mediatek,mt6360-adc";
				#io-channel-cells = <1>;
			};

			/*
			 * Only the SD card supplies are described; the other
			 * MT6360 rails keep their bootloader state.
			 */
			/* rear flash: FLED1 (vendor: torch 37.5 mA, strobe 750 mA / 1.248 s) */
			led-controller {
				compatible = "mediatek,mt6360-led";
				#address-cells = <1>;
				#size-cells = <0>;

				led@4 {
					reg = <4>;
					function = LED_FUNCTION_FLASH;
					color = <LED_COLOR_ID_WHITE>;
					led-max-microamp = <100000>;
					flash-max-microamp = <750000>;
					flash-max-timeout-us = <1248000>;
				};
			};

			regulator {
				compatible = "mediatek,mt6360-regulator";

				mt6360_ldo3: ldo3 {
					regulator-name = "vmc";
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <3300000>;
				};

				mt6360_ldo5: ldo5 {
					regulator-name = "vmch";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
				};
			};

			/* Leaves ICHG/AICR/CV as set by the bootloader (stock: 2 A / 0.5 A / 4.4 V). */
			mt6360_chg: charger {
				compatible = "mediatek,mt6360-chg";
				richtek,vinovp-microvolt = <6500000>;
			};
		};
	};
};

/ {
	/*
	 * Samsung EB-BA226ABY (5000 mAh). OCV curve resampled from the stock
	 * MTK GM3.0 profile (bat_gm30, battery0_profile_t1, 25 degC).
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <5000000>;
		/* ~120 mOhm at 25 C, stock W1 SCUD/BYD 5000 mAh profiles */
		factory-internal-resistance-micro-ohms = <120000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4400000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4357000 100>,
						<4280721 95>,
						<4221383 90>,
						<4165774 85>,
						<4110504 80>,
						<4070075 75>,
						<3996095 70>,
						<3963975 65>,
						<3931597 60>,
						<3880589 55>,
						<3842700 50>,
						<3819808 45>,
						<3802441 40>,
						<3787965 35>,
						<3776921 30>,
						<3762025 25>,
						<3743598 20>,
						<3716495 15>,
						<3691341 10>,
						<3650438 5>,
						<3400000 0>;
	};

	/* coulomb counter of the MT6359 PMIC; VBAT from the MT6360 ADC */
	fuel-gauge {
		compatible = "mediatek,mt6359-fuel-gauge";
		mediatek,pmic = <&mt6359>;
		/* R_FG_VALUE 5 mOhm, CAR_TUNE 100 % (stock mt6833_battery_prop.dtsi) */
		mediatek,sense-resistor-micro-ohms = <5000>;
		io-channels = <&mt6360_adc 4>;
		io-channel-names = "voltage";
		monitored-battery = <&battery>;
		power-supplies = <&mt6360_chg>;
	};
};

/ {
	/*
	 * PMIC wrapper + MT6359 main PMIC. Separate node name from the stock
	 * "pwrap@10026000" (kept disabled) so the two do not get merged.
	 * The pwrap is already initialised by the bootloader.
	 */
	pmic-wrapper@10026000 {
		compatible = "mediatek,mt6833-pwrap";
		reg = <0 0x10026000 0 0x1000>;
		reg-names = "pwrap";
		interrupts = <0 220 4>;
		clocks = <&infracfg_ao CLK_IFRAO_PMIC_AP>,
			 <&infracfg_ao CLK_IFRAO_PMIC_TMR>;
		clock-names = "spi", "wrap";

		mt6359: pmic {
			compatible = "mediatek,mt6359";
			interrupts-extended = <&pio_ml 118 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <2>;

			rtc {
				compatible = "mediatek,mt6358-rtc";
			};

			/* headset jack detection; values from the vendor accdet node */
			mt6359_accdet: accdet {
				compatible = "mediatek,mt6359-accdet";
				mediatek,mic-vol = <8>;
				mediatek,plugout-debounce = <1>;
				mediatek,mic-mode = <2>;
				mediatek,pwm-deb-setting = <0x500 0x500 0x1 0x1f0
							    0x800 0x800 0x20 0x44
							    0x4 0x1 0x5 0x3 0x3 0x5 0xe>;
				mediatek,eint-use-ext-res = <0>;
				mediatek,key-mode = <0>;
				mediatek,three-key-thr = <0 80 220 400>;
			};

			mt6359codec {
				mediatek,dmic-mode = <0>;	/* two-wire */
				/*
				 * DCC: the stock DT has no mic-type, so the vendor
				 * driver uses its default DCC; with ACC the ADC
				 * delivers only zeros.
				 */
				mediatek,mic-type-0 = <3>;
				mediatek,mic-type-1 = <3>;
				mediatek,mic-type-2 = <3>;
			};

			/*
			 * Only the GPU rails are described; every other MT6359
			 * regulator stays as the bootloader configured it.
			 * vgpu follows the GPU OPP table (fixed 0.78125 V for now,
			 * see gpu_opp_table); vsram_gpu stays at 0.85 V.
			 */
			regulators {
				mt6359_vproc1_buck_reg: buck_vproc1 {
					regulator-name = "vgpu";
					regulator-min-microvolt = <625000>;
					regulator-max-microvolt = <781250>;
					/* MT6359 driver has no slew info; vendor waits ~5 mV/us */
					regulator-ramp-delay = <5000>;
					regulator-enable-ramp-delay = <200>;
				};

				/*
				 * CPU rails (vendor kernel: big = vgpu11 +
				 * vsram_proc1, LITTLE + CCI = vproc2 +
				 * vsram_proc2). Never switched off; the
				 * ranges cover the bootloader setting so
				 * nothing changes until cpufreq asks.
				 */
				mt6359_vgpu11_buck_reg: buck_vgpu11 {
					regulator-name = "vproc_big";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <1000000>;
					regulator-ramp-delay = <5000>;
					regulator-always-on;
				};

				mt6359_vproc2_buck_reg: buck_vproc2 {
					regulator-name = "vproc_little";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <1000000>;
					regulator-ramp-delay = <5000>;
					regulator-always-on;
				};

				mt6359_vsram_proc1_ldo_reg: ldo_vsram_proc1 {
					regulator-name = "vsram_big";
					regulator-min-microvolt = <750000>;
					regulator-max-microvolt = <1000000>;
					regulator-ramp-delay = <5000>;
					regulator-always-on;
				};

				mt6359_vsram_proc2_ldo_reg: ldo_vsram_proc2 {
					regulator-name = "vsram_little";
					regulator-min-microvolt = <750000>;
					regulator-max-microvolt = <1000000>;
					regulator-ramp-delay = <5000>;
					regulator-always-on;
				};

				/* vibration motor (vendor 3.0 V; 3.3 V for a stronger buzz) */
				mt6359_vibr_ldo_reg: ldo_vibr {
					regulator-name = "vibr";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
				};

				/* connectivity (CONSYS + MT6631), ranges from the vendor DT */
				mt6359_vcn18_ldo_reg: ldo_vcn18 {
					regulator-name = "vcn18";
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				mt6359_vcn13_ldo_reg: ldo_vcn13 {
					regulator-name = "vcn13";
					regulator-min-microvolt = <900000>;
					regulator-max-microvolt = <1300000>;
				};

				mt6359_vcn33_1_ldo_reg: ldo_vcn33_1 {
					regulator-name = "vcn33_1";
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <3500000>;
				};

				mt6359_vcn33_2_ldo_reg: ldo_vcn33_2 {
					regulator-name = "vcn33_2";
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <3500000>;
				};

				mt6359_vsram_md_ldo_reg: ldo_vsram_md {
					regulator-name = "vsram_gpu";
					regulator-min-microvolt = <850000>;
					regulator-max-microvolt = <850000>;
					regulator-enable-ramp-delay = <240>;
				};
			};

			keys {
				compatible = "mediatek,mt6359-keys";

				power-key {
					linux,keycodes = <KEY_POWER>;
					wakeup-source;
				};

				/* Wired to the volume-down button on SM-A226B. */
				home-key {
					linux,keycodes = <KEY_VOLUMEDOWN>;
				};
			};
		};
	};
};

/ {
	/* Panel brightness via DCS 0x51 on the LK-initialised DSI0 (video mode). */
	backlight: backlight@14013000 {
		compatible = "mediatek,dsi-vm-backlight";
		reg = <0 0x14013000 0 0x1000>;
		/* BCTRL | DD | BL, as the vendor panel driver sets it */
		mediatek,wrctrld = <0x2c>;
		default-brightness-level = <200>;
	};
};

/ {
	/* SoC keypad: only volume-up (stock hw map index 1 = row 0, col 1). */
	keypad@10010000 {
		compatible = "mediatek,mt6833-keypad", "mediatek,mt6779-keypad";
		reg = <0 0x10010000 0 0x1000>;
		interrupts = <0 74 IRQ_TYPE_EDGE_RISING>;
		clocks = <&uart_clk>;
		clock-names = "kpd";
		pinctrl-names = "default";
		pinctrl-0 = <&keypad_pins>;
		linux,keymap = <MATRIX_KEY(0x00, 0x01, KEY_VOLUMEUP)>;
		keypad,num-rows = <1>;
		keypad,num-columns = <2>;
		debounce-delay-ms = <32>;
		wakeup-source;
	};
};

/ {
	/* "infra_pdn" in the vendor kernel: holds the MFG1 AXI way-enable */
	infra_pdn: syscon@10215000 {
		compatible = "mediatek,mt6833-infra-pdn", "syscon";
		reg = <0 0x10215000 0 0x1000>;
	};

	scpsys_ml: syscon@10006000 {
		compatible = "mediatek,mt6833-scpsys", "syscon", "simple-mfd";
		reg = <0 0x10006000 0 0x1000>;

		/* GPU (MFG) and audio domains; the others are left to the bootloader. */
		spm: power-controller {
			compatible = "mediatek,mt6833-power-controller";
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <1>;

			power-domain@MT6833_POWER_DOMAIN_CONN {
				reg = <MT6833_POWER_DOMAIN_CONN>;
				mediatek,infracfg = <&infracfg_ao>;
				#power-domain-cells = <0>;
			};

			power-domain@MT6833_POWER_DOMAIN_AUDIO {
				reg = <MT6833_POWER_DOMAIN_AUDIO>;
				clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>,
					 <&infracfg_ao CLK_IFRAO_AUDIO_26M_BCLK>,
					 <&infracfg_ao CLK_IFRAO_AUDIO>;
				clock-names = "audio", "audio1", "audio2";
				mediatek,infracfg = <&infracfg_ao>;
				#power-domain-cells = <0>;
			};

			mfg0: power-domain@MT6833_POWER_DOMAIN_MFG0 {
				reg = <MT6833_POWER_DOMAIN_MFG0>;
				domain-supply = <&mt6359_vproc1_buck_reg>;
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				mfg1: power-domain@MT6833_POWER_DOMAIN_MFG1 {
					reg = <MT6833_POWER_DOMAIN_MFG1>;
					clocks = <&topckgen CLK_TOP_MFG_PLL_SEL>,
						 <&topckgen CLK_TOP_MFG_REF_SEL>;
					clock-names = "mfg", "alt";
					domain-supply = <&mt6359_vsram_md_ldo_reg>;
					mediatek,infracfg = <&infracfg_ao>;
					mediatek,infracfg-nao = <&infra_pdn>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT6833_POWER_DOMAIN_MFG2 {
						reg = <MT6833_POWER_DOMAIN_MFG2>;
						#power-domain-cells = <0>;
					};

					power-domain@MT6833_POWER_DOMAIN_MFG3 {
						reg = <MT6833_POWER_DOMAIN_MFG3>;
						#power-domain-cells = <0>;
					};
				};
			};
		};
	};

	mfgcfg_ml: clock-controller@13fbf000 {
		compatible = "mediatek,mt6833-mfgcfg";
		reg = <0 0x13fbf000 0 0x1000>;
		/* registers only respond with the GPU top domain powered */
		power-domains = <&spm MT6833_POWER_DOMAIN_MFG1>;
		#clock-cells = <1>;
	};

	/* Mali-G57 MC2, same GPU configuration as MT8370 */
	gpu: gpu@13000000 {
		compatible = "mediatek,mt6833-mali", "mediatek,mt8370-mali",
			     "arm,mali-valhall-jm";
		reg = <0 0x13000000 0 0x4000>;
		interrupts = <0 366 4>, <0 365 4>, <0 364 4>;
		interrupt-names = "job", "mmu", "gpu";
		clocks = <&mfgcfg_ml CLK_MFGCFG_BG3D>;
		power-domains = <&spm MT6833_POWER_DOMAIN_MFG2>,
				<&spm MT6833_POWER_DOMAIN_MFG3>;
		power-domain-names = "core0", "core1";
		mali-supply = <&mt6359_vproc1_buck_reg>;
		operating-points-v2 = <&gpu_opp_table>;
		#cooling-cells = <2>;
	};

	/*
	 * Frequencies from the Samsung/MediaTek MT6833 GPU table. The vendor
	 * voltages (0.625 V and up) rely on EEMG calibration, which is not done
	 * here: with them the GPU randomly hung or read garbage (job timeouts,
	 * SLAVE/translation faults, about every second boot). A fixed 0.78125 V
	 * (the 955 MHz voltage) with VSRAM 0.85 V was clean on every test boot.
	 * The vendor table lists 1000/1068 MHz, but MFGPLL_CON1 ignores any
	 * PCW above the 955 MHz setting on this chip (Dimensity 700 is rated
	 * for 950 MHz), so the table stops there.
	 */
	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-390000000 {
			opp-hz = /bits/ 64 <390000000>;
			opp-microvolt = <781250>;
		};
		opp-467000000 {
			opp-hz = /bits/ 64 <467000000>;
			opp-microvolt = <781250>;
		};
		opp-545000000 {
			opp-hz = /bits/ 64 <545000000>;
			opp-microvolt = <781250>;
		};
		opp-622000000 {
			opp-hz = /bits/ 64 <622000000>;
			opp-microvolt = <781250>;
		};
		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <781250>;
		};
		opp-790000000 {
			opp-hz = /bits/ 64 <790000000>;
			opp-microvolt = <781250>;
		};
		opp-880000000 {
			opp-hz = /bits/ 64 <880000000>;
			opp-microvolt = <781250>;
		};
		opp-955000000 {
			opp-hz = /bits/ 64 <955000000>;
			opp-microvolt = <781250>;
		};
	};
};

/*
 * CPU DVFS: Linux retunes the cluster PLLs itself (mediatek-cpufreq) instead
 * of the vendor CPUHVFS/MCUPM path. Tables are the vendor B20G level that
 * this device is built for (MTK_5GCM_PROJECT), with the unadjusted (pre-EEM)
 * voltages. The CCI shares Vproc2 with LITTLE and is scaled by
 * mtk-cci-devfreq from the CPU OPPs' required-opps.
 */
/ {
	mcusys: syscon@c53a000 {
		compatible = "mediatek,mt6833-mcusys", "syscon";
		reg = <0 0x0c53a000 0 0x1000>;
		#clock-cells = <1>;
	};

	/* CCI follows the busier cluster (vendor B20G "normal" CCI map) */
	cci: cci {
		compatible = "mediatek,mt6833-cci";
		clocks = <&mcusys CLK_MCU_ARMPLL_BUS_SEL>, <&clk26m>;
		clock-names = "cci", "intermediate";
		operating-points-v2 = <&cci_opp>;
		proc-supply = <&mt6359_vproc2_buck_reg>;
		sram-supply = <&mt6359_vsram_proc2_ldo_reg>;
	};

	cci_opp: opp-table-cci {
		compatible = "operating-points-v2";
		opp-shared;

		cci_opp_450: opp-450000000 {
			opp-hz = /bits/ 64 <450000000>;
			opp-microvolt = <650000>;
		};

		cci_opp_506: opp-506000000 {
			opp-hz = /bits/ 64 <506000000>;
			opp-microvolt = <668750>;
		};

		cci_opp_562: opp-562000000 {
			opp-hz = /bits/ 64 <562000000>;
			opp-microvolt = <687500>;
		};

		cci_opp_618: opp-618000000 {
			opp-hz = /bits/ 64 <618000000>;
			opp-microvolt = <706250>;
		};

		cci_opp_675: opp-675000000 {
			opp-hz = /bits/ 64 <675000000>;
			opp-microvolt = <725000>;
		};

		cci_opp_750: opp-750000000 {
			opp-hz = /bits/ 64 <750000000>;
			opp-microvolt = <750000>;
		};

		cci_opp_825: opp-825000000 {
			opp-hz = /bits/ 64 <825000000>;
			opp-microvolt = <775000>;
		};

		cci_opp_900: opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <800000>;
		};

		cci_opp_975: opp-975000000 {
			opp-hz = /bits/ 64 <975000000>;
			opp-microvolt = <825000>;
		};
	};

	cluster0_opp: opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <650000>;
			required-opps = <&cci_opp_450>;
		};

		opp-620000000 {
			opp-hz = /bits/ 64 <620000000>;
			opp-microvolt = <650000>;
			required-opps = <&cci_opp_450>;
		};

		opp-675000000 {
			opp-hz = /bits/ 64 <675000000>;
			opp-microvolt = <662500>;
			required-opps = <&cci_opp_450>;
		};

		opp-730000000 {
			opp-hz = /bits/ 64 <730000000>;
			opp-microvolt = <675000>;
			required-opps = <&cci_opp_450>;
		};

		opp-840000000 {
			opp-hz = /bits/ 64 <840000000>;
			opp-microvolt = <700000>;
			required-opps = <&cci_opp_450>;
		};

		opp-950000000 {
			opp-hz = /bits/ 64 <950000000>;
			opp-microvolt = <725000>;
			required-opps = <&cci_opp_450>;
		};

		opp-1032000000 {
			opp-hz = /bits/ 64 <1032000000>;
			opp-microvolt = <743750>;
			required-opps = <&cci_opp_506>;
		};

		opp-1115000000 {
			opp-hz = /bits/ 64 <1115000000>;
			opp-microvolt = <762500>;
			required-opps = <&cci_opp_562>;
		};

		opp-1280000000 {
			opp-hz = /bits/ 64 <1280000000>;
			opp-microvolt = <800000>;
			required-opps = <&cci_opp_618>;
		};

		opp-1390000000 {
			opp-hz = /bits/ 64 <1390000000>;
			opp-microvolt = <825000>;
			required-opps = <&cci_opp_675>;
		};

		opp-1500000000 {
			opp-hz = /bits/ 64 <1500000000>;
			opp-microvolt = <850000>;
			required-opps = <&cci_opp_750>;
		};

		opp-1645000000 {
			opp-hz = /bits/ 64 <1645000000>;
			opp-microvolt = <893750>;
			required-opps = <&cci_opp_825>;
		};

		opp-1750000000 {
			opp-hz = /bits/ 64 <1750000000>;
			opp-microvolt = <925000>;
			required-opps = <&cci_opp_900>;
		};

		opp-1812000000 {
			opp-hz = /bits/ 64 <1812000000>;
			opp-microvolt = <943750>;
			required-opps = <&cci_opp_900>;
		};

		opp-1916000000 {
			opp-hz = /bits/ 64 <1916000000>;
			opp-microvolt = <975000>;
			required-opps = <&cci_opp_975>;
		};

		opp-2000000000 {
			opp-hz = /bits/ 64 <2000000000>;
			opp-microvolt = <1000000>;
			required-opps = <&cci_opp_975>;
		};
	};

	cluster1_opp: opp-table-cluster1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-725000000 {
			opp-hz = /bits/ 64 <725000000>;
			opp-microvolt = <650000>;
			required-opps = <&cci_opp_450>;
		};

		opp-840000000 {
			opp-hz = /bits/ 64 <840000000>;
			opp-microvolt = <681250>;
			required-opps = <&cci_opp_450>;
		};

		opp-898000000 {
			opp-hz = /bits/ 64 <898000000>;
			opp-microvolt = <700000>;
			required-opps = <&cci_opp_450>;
		};

		opp-985000000 {
			opp-hz = /bits/ 64 <985000000>;
			opp-microvolt = <725000>;
			required-opps = <&cci_opp_506>;
		};

		opp-1042000000 {
			opp-hz = /bits/ 64 <1042000000>;
			opp-microvolt = <737500>;
			required-opps = <&cci_opp_506>;
		};

		opp-1129000000 {
			opp-hz = /bits/ 64 <1129000000>;
			opp-microvolt = <756250>;
			required-opps = <&cci_opp_562>;
		};

		opp-1274000000 {
			opp-hz = /bits/ 64 <1274000000>;
			opp-microvolt = <800000>;
			required-opps = <&cci_opp_618>;
		};

		opp-1418000000 {
			opp-hz = /bits/ 64 <1418000000>;
			opp-microvolt = <843750>;
			required-opps = <&cci_opp_675>;
		};

		opp-1534000000 {
			opp-hz = /bits/ 64 <1534000000>;
			opp-microvolt = <875000>;
			required-opps = <&cci_opp_750>;
		};

		opp-1650000000 {
			opp-hz = /bits/ 64 <1650000000>;
			opp-microvolt = <906250>;
			required-opps = <&cci_opp_825>;
		};

		opp-1720000000 {
			opp-hz = /bits/ 64 <1720000000>;
			opp-microvolt = <925000>;
			required-opps = <&cci_opp_825>;
		};

		opp-1790000000 {
			opp-hz = /bits/ 64 <1790000000>;
			opp-microvolt = <943750>;
			required-opps = <&cci_opp_900>;
		};

		opp-1836000000 {
			opp-hz = /bits/ 64 <1836000000>;
			opp-microvolt = <950000>;
			required-opps = <&cci_opp_900>;
		};

		opp-1906000000 {
			opp-hz = /bits/ 64 <1906000000>;
			opp-microvolt = <968750>;
			required-opps = <&cci_opp_975>;
		};

		opp-1953000000 {
			opp-hz = /bits/ 64 <1953000000>;
			opp-microvolt = <981250>;
			required-opps = <&cci_opp_975>;
		};

		opp-2000000000 {
			opp-hz = /bits/ 64 <2000000000>;
			opp-microvolt = <993750>;
			required-opps = <&cci_opp_975>;
		};
	};
};

&cpu0 {
	clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>, <&clk26m>;
	clock-names = "cpu", "intermediate";
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
	mediatek,cci = <&cci>;
	proc-supply = <&mt6359_vproc2_buck_reg>;
	sram-supply = <&mt6359_vsram_proc2_ldo_reg>;
};

&cpu1 {
	clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>, <&clk26m>;
	clock-names = "cpu", "intermediate";
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
	mediatek,cci = <&cci>;
	proc-supply = <&mt6359_vproc2_buck_reg>;
	sram-supply = <&mt6359_vsram_proc2_ldo_reg>;
};

&cpu2 {
	clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>, <&clk26m>;
	clock-names = "cpu", "intermediate";
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
	mediatek,cci = <&cci>;
	proc-supply = <&mt6359_vproc2_buck_reg>;
	sram-supply = <&mt6359_vsram_proc2_ldo_reg>;
};

&cpu3 {
	clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>, <&clk26m>;
	clock-names = "cpu", "intermediate";
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
	mediatek,cci = <&cci>;
	proc-supply = <&mt6359_vproc2_buck_reg>;
	sram-supply = <&mt6359_vsram_proc2_ldo_reg>;
};

&cpu4 {
	clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>, <&clk26m>;
	clock-names = "cpu", "intermediate";
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
	mediatek,cci = <&cci>;
	proc-supply = <&mt6359_vproc2_buck_reg>;
	sram-supply = <&mt6359_vsram_proc2_ldo_reg>;
};

&cpu5 {
	clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>, <&clk26m>;
	clock-names = "cpu", "intermediate";
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
	mediatek,cci = <&cci>;
	proc-supply = <&mt6359_vproc2_buck_reg>;
	sram-supply = <&mt6359_vsram_proc2_ldo_reg>;
};

&cpu6 {
	clocks = <&mcusys CLK_MCU_ARMPLL_BL_SEL>, <&clk26m>;
	clock-names = "cpu", "intermediate";
	operating-points-v2 = <&cluster1_opp>;
	#cooling-cells = <2>;
	mediatek,cci = <&cci>;
	proc-supply = <&mt6359_vgpu11_buck_reg>;
	sram-supply = <&mt6359_vsram_proc1_ldo_reg>;
};

&cpu7 {
	clocks = <&mcusys CLK_MCU_ARMPLL_BL_SEL>, <&clk26m>;
	clock-names = "cpu", "intermediate";
	operating-points-v2 = <&cluster1_opp>;
	#cooling-cells = <2>;
	mediatek,cci = <&cci>;
	proc-supply = <&mt6359_vgpu11_buck_reg>;
	sram-supply = <&mt6359_vsram_proc1_ldo_reg>;
};

/*
 * Thermal: LVTS sensors (vendor plan: LITTLE 1-0..1-3, big 2-0/2-1,
 * GPU 3-0/3-1, SoC 3-2, CONSYS 3-3, modem 4-x) with the vendor CPU trip
 * points: throttle from 85 C, harder from 95 C, shut down at 117 C.
 */
/ {
	efuse_ml: efuse@11c10000 {
		compatible = "mediatek,mt6833-efuse", "mediatek,efuse";
		reg = <0 0x11c10000 0 0x1000>;
		#address-cells = <1>;
		#size-cells = <1>;

		lvts_e_data1: data1@1c0 {
			reg = <0x1c0 0x58>;
		};
	};

	lvts: thermal-sensor@1100b000 {
		compatible = "mediatek,mt6833-lvts-ap";
		reg = <0 0x1100b000 0 0xc00>;
		interrupts = <0 169 4>;
		clocks = <&infracfg_ao CLK_IFRAO_THERM>;
		nvmem-cells = <&lvts_e_data1>;
		nvmem-cell-names = "lvts-calib-data-1";
		#thermal-sensor-cells = <1>;
	};

	thermal-zones {
		cpu-little-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6833_AP_LITTLE1>;

			trips {
				little_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				little_hot: trip-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				little_crit: trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
			cooling-maps {
				map0 {
					trip = <&little_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map1 {
					trip = <&little_hot>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-big-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6833_AP_BIG1>;

			trips {
				big_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				big_hot: trip-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				big_crit: trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
			cooling-maps {
				map0 {
					trip = <&big_alert>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map1 {
					trip = <&big_hot>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6833_AP_GPU1>;

			trips {
				gpu_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu_hot: trip-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu_crit: trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
			cooling-maps {
				map0 {
					trip = <&gpu_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map1 {
					trip = <&gpu_hot>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		soc-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6833_AP_SOC>;

			trips {
				soc_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_hot: trip-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_crit: trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};
	};
};

/* Audio: MT8192-compatible AFE + MT6359 codec (speaker amplifier pending) */
/ {
	audsys_ml: syscon@11210000 {
		compatible = "mediatek,mt6833-audsys", "syscon";
		reg = <0 0x11210000 0 0x2000>;
		#clock-cells = <1>;

		afe_ml: audio-controller {
			compatible = "mediatek,mt6833-audio";
			interrupts = <0 202 4>;
			mediatek,apmixedsys = <&apmixed>;
			mediatek,infracfg = <&infracfg_ao>;
			mediatek,topckgen = <&topckgen>;
			power-domains = <&spm MT6833_POWER_DOMAIN_AUDIO>;
			clocks = <&audsys_ml CLK_AUDSYS_AFE>,
				 <&audsys_ml CLK_AUDSYS_DAC>,
				 <&audsys_ml CLK_AUDSYS_DAC_PREDIS>,
				 <&audsys_ml CLK_AUDSYS_ADC>,
				 <&audsys_ml CLK_AUDSYS_ADDA6_ADC>,
				 <&audsys_ml CLK_AUDSYS_22M>,
				 <&audsys_ml CLK_AUDSYS_24M>,
				 <&audsys_ml CLK_AUDSYS_APLL_TUNER>,
				 <&audsys_ml CLK_AUDSYS_APLL2_TUNER>,
				 <&audsys_ml CLK_AUDSYS_TDM>,
				 <&audsys_ml CLK_AUDSYS_TML>,
				 <&audsys_ml CLK_AUDSYS_NLE>,
				 <&audsys_ml CLK_AUDSYS_DAC_HIRES>,
				 <&audsys_ml CLK_AUDSYS_ADC_HIRES>,
				 <&audsys_ml CLK_AUDSYS_ADC_HIRES_TML>,
				 <&audsys_ml CLK_AUDSYS_ADDA6_ADC_HIRES>,
				 <&audsys_ml CLK_AUDSYS_3RD_DAC>,
				 <&audsys_ml CLK_AUDSYS_3RD_DAC_PREDIS>,
				 <&audsys_ml CLK_AUDSYS_3RD_DAC_TML>,
				 <&audsys_ml CLK_AUDSYS_3RD_DAC_HIRES>,
				 <&infracfg_ao CLK_IFRAO_AUDIO>,
				 <&infracfg_ao CLK_IFRAO_AUDIO_26M_BCLK>,
				 <&topckgen CLK_TOP_AUDIO_SEL>,
				 <&topckgen CLK_TOP_AUD_INTBUS_SEL>,
				 <&topckgen CLK_TOP_MAINPLL_D4_D4>,
				 <&topckgen CLK_TOP_AUD_1_SEL>,
				 <&topckgen CLK_TOP_APLL1>,
				 <&topckgen CLK_TOP_AUD_2_SEL>,
				 <&topckgen CLK_TOP_APLL2>,
				 <&topckgen CLK_TOP_AUD_ENGEN1_SEL>,
				 <&topckgen CLK_TOP_APLL1_D4>,
				 <&topckgen CLK_TOP_AUD_ENGEN2_SEL>,
				 <&topckgen CLK_TOP_APLL2_D4>,
				 <&topckgen CLK_TOP_APLL_I2S0_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S1_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S2_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S3_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S4_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S5_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S6_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S7_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S8_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL_I2S9_MCK_SEL>,
				 <&topckgen CLK_TOP_APLL12_CK_DIV0>,
				 <&topckgen CLK_TOP_APLL12_CK_DIV1>,
				 <&topckgen CLK_TOP_APLL12_CK_DIV2>,
				 <&topckgen CLK_TOP_APLL12_CK_DIV3>,
				 <&topckgen CLK_TOP_APLL12_CK_DIV4>,
				 <&topckgen CLK_TOP_APLL12_CK_DIVB>,
				 <&topckgen CLK_TOP_APLL12_CK_DIV5>,
				 <&topckgen CLK_TOP_APLL12_CK_DIV6>,
				 <&topckgen CLK_TOP_APLL12_CK_DIV7>,
				 <&topckgen CLK_TOP_AUDIO_H_SEL>,
				 <&topckgen CLK_TOP_TCK_26M_MX9>;
			clock-names = "aud_afe_clk", "aud_dac_clk",
				      "aud_dac_predis_clk", "aud_adc_clk",
				      "aud_adda6_adc_clk", "aud_apll22m_clk",
				      "aud_apll24m_clk", "aud_apll1_tuner_clk",
				      "aud_apll2_tuner_clk", "aud_tdm_clk",
				      "aud_tml_clk", "aud_nle",
				      "aud_dac_hires_clk", "aud_adc_hires_clk",
				      "aud_adc_hires_tml", "aud_adda6_adc_hires_clk",
				      "aud_3rd_dac_clk", "aud_3rd_dac_predis_clk",
				      "aud_3rd_dac_tml", "aud_3rd_dac_hires_clk",
				      "aud_infra_clk", "aud_infra_26m_clk",
				      "top_mux_audio", "top_mux_audio_int",
				      "top_mainpll_d4_d4", "top_mux_aud_1",
				      "top_apll1_ck", "top_mux_aud_2",
				      "top_apll2_ck", "top_mux_aud_eng1",
				      "top_apll1_d4", "top_mux_aud_eng2",
				      "top_apll2_d4", "top_i2s0_m_sel",
				      "top_i2s1_m_sel", "top_i2s2_m_sel",
				      "top_i2s3_m_sel", "top_i2s4_m_sel",
				      "top_i2s5_m_sel", "top_i2s6_m_sel",
				      "top_i2s7_m_sel", "top_i2s8_m_sel",
				      "top_i2s9_m_sel", "top_apll12_div0",
				      "top_apll12_div1", "top_apll12_div2",
				      "top_apll12_div3", "top_apll12_div4",
				      "top_apll12_divb", "top_apll12_div5",
				      "top_apll12_div6", "top_apll12_div7",
				      "top_mux_audio_h", "top_clk26m_clk";
		};
	};

	/*
	 * SIA8109 analog class-D/K speaker amplifier. Its one-wire mode
	 * interface (N rising edges after >1 ms low, then held high; vendor
	 * mode 6) is the same as the AW8738 pulse protocol.
	 */
	sia8109_amp: audio-amplifier {
		compatible = "awinic,aw8738";
		mode-gpios = <&pio_ml 169 GPIO_ACTIVE_HIGH>;
		awinic,mode = <6>;
		pinctrl-names = "default";
		pinctrl-0 = <&spk_amp_pins>;
		sound-name-prefix = "Speaker Amp";
	};

	sound_ml: sound {
		/* drop the vendor card description merged into this node */
		/delete-property/ mediatek,audio-codec;
		/delete-property/ mtk_spk_i2s_out;
		/delete-property/ mtk_spk_i2s_in;
		/delete-property/ si,sia81xx-max-num;
		/delete-property/ si,sia81xx-aux-devs;
		/delete-property/ si,sia81xx-aux-devs-prefix;
		compatible = "mediatek,mt6833-mt6359-sound";
		status = "okay";
		mediatek,speaker-amplifier = <&sia8109_amp>;
		mediatek,accdet = <&mt6359_accdet>;
		mediatek,platform = <&afe_ml>;
		pinctrl-names = "aud_clk_mosi_off", "aud_clk_mosi_on", "aud_dat_mosi_off", "aud_dat_mosi_on", "aud_dat_miso_off", "aud_dat_miso_on", "aud_gpio_i2s3_off", "aud_gpio_i2s3_on", "aud_gpio_i2s0_off", "aud_gpio_i2s0_on";
		pinctrl-0 = <&aud_clk_mosi_off_ml>;
		pinctrl-1 = <&aud_clk_mosi_on_ml>;
		pinctrl-2 = <&aud_dat_mosi_off_ml>;
		pinctrl-3 = <&aud_dat_mosi_on_ml>;
		pinctrl-4 = <&aud_dat_miso_off_ml>;
		pinctrl-5 = <&aud_dat_miso_on_ml>;
		pinctrl-6 = <&aud_gpio_i2s3_off_ml>;
		pinctrl-7 = <&aud_gpio_i2s3_on_ml>;
		pinctrl-8 = <&aud_gpio_i2s0_off_ml>;
		pinctrl-9 = <&aud_gpio_i2s0_on_ml>;
	};
};

/ {
	vibrator {
		compatible = "regulator-haptic";
		haptic-supply = <&mt6359_vibr_ldo_reg>;
		min-microvolt = <3300000>;
		max-microvolt = <3300000>;
	};
};

/*
 * Connectivity (CONSYS + MT6631 A-die), driven by the vendor wmt_drv/btif/
 * wlan modules built out of tree (~/nura-a22x/conn).
 */
&{/btif@1100c000} {
	clocks = <&infracfg_ao CLK_IFRAO_BTIF>, <&infracfg_ao CLK_IFRAO_AP_DMA>;
	clock-names = "btifc", "apdmac";
	status = "okay";
};

&consys {
	clocks = <&infracfg_ao CLK_IFRAO_CCIF4_AP>;
	clock-names = "ccif";
	power-domains = <&spm MT6833_POWER_DOMAIN_CONN>;
	memory-region = <&{/reserved-memory/consys-reserve-memory}>;
	vcn18-supply = <&mt6359_vcn18_ldo_reg>;
	vcn13-supply = <&mt6359_vcn13_ldo_reg>;
	vcn33_1_bt-supply = <&mt6359_vcn33_1_ldo_reg>;
	vcn33_1_wifi-supply = <&mt6359_vcn33_1_ldo_reg>;
	vcn33_2_wifi-supply = <&mt6359_vcn33_2_ldo_reg>;
	status = "okay";
};

&{/wifi@18000000} {
	memory-region = <&{/reserved-memory/wifi-reserve-memory}>;
	status = "okay";
};

/*
 * CPU idle. The stock idle states are "mediatek,idle-state", which the PSCI
 * cpuidle driver ignores, so the CPUs only ever did WFI. Enable the CPU-off
 * and cluster-off states (handled by ATF alone, as on MT8192); mcusys-off
 * and the s2idle state need the SPM/MCUPM side and stay unused for now.
 */
&cpuoff_l {
	compatible = "arm,idle-state";
};

&cpuoff_b {
	compatible = "arm,idle-state";
};

&clusteroff_l {
	compatible = "arm,idle-state";
};

&clusteroff_b {
	compatible = "arm,idle-state";
};

&{/cpus/cpu@000} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
&{/cpus/cpu@001} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
&{/cpus/cpu@002} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
&{/cpus/cpu@003} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
&{/cpus/cpu@004} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
&{/cpus/cpu@005} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
&{/cpus/cpu@100} { cpu-idle-states = <&cpuoff_b &clusteroff_b>; };
&{/cpus/cpu@101} { cpu-idle-states = <&cpuoff_b &clusteroff_b>; };

/ {
	/*
	 * SoC system timer: keeps running while a CPU's arch timer is off in
	 * an idle state (broadcast wakeups; else only bc_hrtimer is there).
	 */
	timer@10017000 {
		compatible = "mediatek,mt6833-timer", "mediatek,mt6765-timer";
		reg = <0 0x10017000 0 0x1000>;
		interrupts = <0 233 4>;
		clocks = <&clk13m>;
	};
};
