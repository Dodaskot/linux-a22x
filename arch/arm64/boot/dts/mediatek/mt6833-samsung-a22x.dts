// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
/*
 * Samsung Galaxy A22 5G (SM-A226B, "a22x") - minimal mainline bring-up.
 *
 * The stock LK looks up a lot of nodes in the kernel DTB, applies dtbo.img on
 * top of it and panics when something is missing (bootargs, mediatek,scp, ...).
 * The base is therefore the stock DTB with everything mainline does not use
 * disabled (see mt6833-samsung-a22x-lk-compat.dtsi); real hardware support
 * is enabled here node by node.
 *
 * No reserved-memory nodes are added here: LK inserts its own mblock
 * reservations (framebuffer, pstore, ...) and hangs in
 * reserved_memory_conflict_check if the DTB already describes them
 * differently. ramoops is configured by LK through ramoops.* cmdline params.
 */

/dts-v1/;
#include <dt-bindings/phy/phy.h>
#include "mt6833-samsung-a22x-lk-compat.dtsi"

/ {
	model = "Samsung Galaxy A22 5G (SM-A226B)";
	compatible = "samsung,a22x", "mediatek,mt6833";

	aliases {
		serial0 = &apuart0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "serial0:921600n8";
		bootargs = "console=ttyS0,921600n8";

		framebuffer@7c9b0000 {
			compatible = "simple-framebuffer";
			reg = <0 0x7c9b0000 0 (1088 * 2408 * 4)>;
			width = <1080>;
			height = <2408>;
			stride = <(1088 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Stand-in clocks until there is a mainline MT6833 clock driver.
	 * Preloader/LK leave these running; rates were measured on the stock
	 * kernel through /proc/clkdbg (dump_clks).
	 */
	clk_msdc50_0: clock-msdc50-0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <384000000>;
		clock-output-names = "msdc50_0_ck";
	};

	clk_axi: clock-axi {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <156000000>;
		clock-output-names = "axi_ck";
	};

	clk_usb_top: clock-usb-top {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <124800000>;
		clock-output-names = "fusb_top_ck";
	};

	/* VEMC, left enabled by the bootloader for the boot eMMC. */
	reg_vemc: regulator-vemc {
		compatible = "regulator-fixed";
		regulator-name = "vemc";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	mmc0: mmc@11230000 {
		compatible = "mediatek,mt8183-mmc";
		reg = <0 0x11230000 0 0x10000>,
		      <0 0x11f50000 0 0x1000>;
		interrupts = <0 99 4>;
		clocks = <&clk_msdc50_0>, <&clk_axi>;
		clock-names = "source", "hclk";
		bus-width = <8>;
		max-frequency = <200000000>;
		cap-mmc-highspeed;
		mmc-hs200-1_8v;
		vmmc-supply = <&reg_vemc>;
		non-removable;
		no-sd;
		no-sdio;
	};

	u2phy: t-phy@11e40000 {
		compatible = "mediatek,mt6833-tphy", "mediatek,generic-tphy-v2";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0x11e40000 0x1000>;

		u2port0: usb-phy@0 {
			reg = <0x0 0x700>;
			clocks = <&uart_clk>;
			clock-names = "ref";
			#phy-cells = <1>;
		};
	};

	usb_otg: usb@11200000 {
		compatible = "mediatek,mt6833-musb", "mediatek,mtk-musb";
		reg = <0 0x11200000 0 0x1000>;
		interrupts = <0 96 4>;
		interrupt-names = "mc";
		phys = <&u2port0 PHY_TYPE_USB2>;
		dr_mode = "peripheral";
		clocks = <&clk_usb_top>, <&clk_axi>, <&clk_usb_top>;
		clock-names = "main", "mcu", "univpll";
	};

	/*
	 * LK leaves the TOPRGU watchdog running; let the kernel service it.
	 * The stock "mediatek,toprgu" node at the same address stays disabled.
	 */
	watchdog@10007000 {
		compatible = "mediatek,mt6833-wdt", "mediatek,mt6589-wdt";
		reg = <0 0x10007000 0 0x100>;
		#reset-cells = <1>;
	};
};

/* The stock fixed clock lacks #clock-cells, so the UART driver cannot use it. */
&uart_clk {
	#clock-cells = <0>;
};
