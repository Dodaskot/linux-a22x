// SPDX-License-Identifier: GPL-2.0-only
/* Opt-in native display bring-up; the regular a22x DT remains the fallback. */
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include "mt6833-samsung-a22x.dts"

/ {
	/* The stock MCUPM controller stays disabled; this driver owns only
	 * the platform, LPM and disabled-EEM mailboxes of boot-loaded firmware.
	 * Reuse the existing reservation: adding a new carveout breaks LK.
	 */
	lpm_ml: power-controller@c55fce0 {
		compatible = "mediatek,mt6833-lpm";
		reg = <0 0x0c55fce0 0 0xa0>, <0 0x0c55fb00 0 0xa0>,
		      <0 0x0c562004 0 4>, <0 0x0c562000 0 4>,
		      <0 0x0c560074 0 4>, <0 0x0c560078 0 4>,
		      <0 0x0c55ff60 0 0xa0>;
		reg-names = "lpm-mailbox", "platform-mailbox", "tx-set", "tx-status",
			    "rx-clear", "rx-status", "eem-mailbox";
		memory-region = <&mcupm_share>;
		mediatek,firmware-config = <&mtk_lpm>;
	};

	aliases {
		rdma0 = &disp_rdma0_ml;
		mutex0 = &disp_mutex_ml;
		dsi0 = &dsi0_ml;
	};

	chosen {
		framebuffer@7c9b0000 {
			status = "disabled";
		};
	};

	panel_vdd_ml: regulator-panel-vdd {
		compatible = "regulator-fixed";
		regulator-name = "panel-enable";
		gpio = <&pio_ml 136 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	panel_vsp_ml: regulator-panel-vsp {
		compatible = "regulator-fixed";
		regulator-name = "panel-positive-bias";
		gpio = <&pio_ml 137 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	panel_vsn_ml: regulator-panel-vsn {
		compatible = "regulator-fixed";
		regulator-name = "panel-negative-bias";
		gpio = <&pio_ml 138 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/* Separate sibling topology: LK modifies its original /dsi@... nodes. */
	display-ml {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* No power-domain dependency: SCPSYS needs these before registration. */
		mm_clk_ml: clock-controller-ml@14000000 {
			compatible = "mediatek,mt6833-display-clocks";
			reg = <0 0x14000000 0 0x1000>;
			#clock-cells = <1>;
		};

		mmsys_ml: syscon@14000000 {
			compatible = "mediatek,mt6833-display", "syscon";
			reg = <0 0x14000000 0 0x1000>;
			power-domains = <&spm MT6833_POWER_DOMAIN_DISP>;
		};

		disp_mutex_ml: mutex@14001000 {
			compatible = "mediatek,mt6833-disp-mutex";
			reg = <0 0x14001000 0 0x1000>;
			clocks = <&mm_clk_ml CLK_MM_DISP_MUTEX0>;
			power-domains = <&spm MT6833_POWER_DOMAIN_DISP>;
		};

		disp_rdma0_ml: rdma@14007000 {
			compatible = "mediatek,mt6833-disp-rdma";
			reg = <0 0x14007000 0 0x1000>, <0 0x14004000 0 0x1000>;
			reg-names = "rdma", "larb";
			interrupts = <GIC_SPI 257 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&mm_clk_ml CLK_MM_DISP_RDMA0>,
				 <&mm_clk_ml CLK_MM_SMI_INFRA>,
				 <&mm_clk_ml CLK_MM_SMI_COMMON>,
				 <&mm_clk_ml CLK_MM_SMI_GALS>,
				 <&mm_clk_ml CLK_MM_SMI_IOMMU>;
			clock-names = "rdma", "smi-infra", "smi-common", "smi-gals", "smi-iommu";
			power-domains = <&spm MT6833_POWER_DOMAIN_DISP>;
		};

		mipi_tx0_ml: phy@11e50000 {
			compatible = "mediatek,mt6833-mipi-tx-cphy";
			reg = <0 0x11e50000 0 0x1000>;
			clocks = <&uart_clk>;
			#clock-cells = <0>;
			#phy-cells = <0>;
			clock-output-names = "mipi_tx0_ml_pll";
		};

		dsi0_ml: dsi-ml@14013000 {
			compatible = "mediatek,mt6833-dsi-cphy";
			reg = <0 0x14013000 0 0x1000>;
			interrupts = <GIC_SPI 269 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&mm_clk_ml CLK_MM_DSI0>,
				 <&mm_clk_ml CLK_MM_DSI0_DSI_CK_DOMAIN>, <&mipi_tx0_ml>;
			clock-names = "engine", "digital", "hs";
			power-domains = <&spm MT6833_POWER_DOMAIN_DISP>;
			phys = <&mipi_tx0_ml>;
			phy-names = "dphy";
			mediatek,cphy-timing = <35 26>;
			#address-cells = <1>;
			#size-cells = <0>;

			panel_ml: panel@0 {
				compatible = "jdi,hx83112f-a22x";
				reg = <0>;
				reset-gpios = <&pio_ml 86 GPIO_ACTIVE_LOW>;
				vdd-supply = <&panel_vdd_ml>;
				vsp-supply = <&panel_vsp_ml>;
				vsn-supply = <&panel_vsn_ml>;
				port {
					panel_in_ml: endpoint {
						remote-endpoint = <&dsi_out_ml>;
					};
				};
			};

			port {
				dsi_out_ml: endpoint {
					remote-endpoint = <&panel_in_ml>;
				};
			};
		};
	};
};

&backlight {
	status = "disabled";
};

&spi1 {
	novatek@0 {
		panel = <&panel_ml>;
	};
};

&spm {
	power-domain@6 {
		reg = <MT6833_POWER_DOMAIN_DISP>;
		clocks = <&topckgen CLK_TOP_DISP_SEL>,
			 <&mm_clk_ml CLK_MM_SMI_INFRA>,
			 <&mm_clk_ml CLK_MM_SMI_COMMON>,
			 <&mm_clk_ml CLK_MM_SMI_GALS>,
			 <&mm_clk_ml CLK_MM_SMI_IOMMU>,
			 <&mm_clk_ml CLK_MM_APB_BUS>;
		clock-names = "disp", "smi-infra", "smi-common", "smi-gals",
			      "smi-iommu", "mm-apb";
		mediatek,infracfg = <&infracfg_ao>;
		#power-domain-cells = <0>;
	};
};
